# Copy this file to .env and fill in your key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# SQLite works out of the box. For PostgreSQL use e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/hiremeai
DATABASE_URL=sqlite:///./hiremeai.db
